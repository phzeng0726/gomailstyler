# SMTP Configuration
# Copy this file to .env and fill in your actual values

# SMTP server hostname (e.g., smtp.gmail.com, smtp.office365.com)
SMTP_HOST=smtp.example.com

# SMTP server port (typically 587 for STARTTLS, 465 for SSL/TLS or others)
SMTP_PORT=587

# Sender email address (must match authenticated user on most servers)
SMTP_SENDER=your-email@example.com

# SMTP password (optional - leave empty for no authentication)
# For Gmail, use an App Password: https://support.google.com/accounts/answer/185833
SMTP_PASSWORD=

# Test recipient email address
MAIL_RECEIVER=recipient@example.com
